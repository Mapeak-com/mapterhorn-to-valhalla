#!/usr/bin/env python3
"""Writes Valhalla elevation tiles from Mapterhorn terrain tiles.

Each 1x1 degree cell becomes a 3601x3601 .hgt file in Valhalla's N32/N32E034.hgt
layout. Without -t, -b or -g the cells are selected as -t does. Like
valhalla_build_elevation, a run writes only cells without a file in any format.

Processed cells are listed in .mapterhorn-to-valhalla.progress in the output
directory. With --migrate, every selected cell not listed there gets its files
in every format replaced; cells without Mapterhorn data lose their files, and
with -t so do cells outside the graph. A stopped --migrate run resumes, and
without the file every cell is processed again.

Usage:
  mapterhorn-to-valhalla [options] [-v...] [-t | -b BBOX | -g DIR] [-d | -z]
  mapterhorn-to-valhalla -h | --help

Options:
  -t --from-tiles          Cells covered by the level-2 tiles of the Valhalla graph in mjolnir.tile_dir of the config,
                           or else in mjolnir.tile_extract.
  -b --from-bbox BBOX      Cells intersecting the bounding box minX,minY,maxX,maxY.
  -g --from-geojson DIR    Cells intersecting the polygons of the .geojson files in DIR. Requires shapely.
  -c --config FILE         Valhalla config JSON.
  -i --inline-config JSON  Inline JSON config, overrides --config [default: {}].
  -o --outdir DIR          Output directory, overrides additional_data.elevation of the config.
  -s --source PMTILES      Mapterhorn archive URL or path [default: https://download.mapterhorn.com/planet.pmtiles].
  -p --parallelism N       Number of cells converted at once, defaults to the number of available cores.
  -d --decompress          Write uncompressed .hgt files.
  -z --lz4                 Write .hgt.lz4 files. Requires lz4.
  -m --migrate             Replace the existing files of cells not listed in the progress file.
  -v --verbosity           Be verbose. Show progress bar on terminals.
  -h --help                Show this screen.
"""

import gzip
import importlib
import itertools
import json
import logging
import multiprocessing
import os
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tarfile
import tempfile
import threading
import time
from collections import namedtuple
from concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor
from functools import partial
from math import ceil, floor, log, pi, radians, tan
from pathlib import Path

def ensure_package(module, package=None):
  """Import a module, installing its package with pip when it is missing."""
  try:
    return importlib.import_module(module)
  except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "--quiet", "--break-system-packages", package or module])
    return importlib.import_module(module)

docopt = ensure_package("docopt").docopt
np = ensure_package("numpy")
gdal = ensure_package("osgeo.gdal", "GDAL")
tqdm = ensure_package("tqdm").tqdm
logging_redirect_tqdm = ensure_package("tqdm.contrib.logging", "tqdm").logging_redirect_tqdm

LOGGER = logging.getLogger("mapterhorn-to-valhalla")
Cell = namedtuple("Cell", ["lon", "lat"])
LOCAL_SIZE = 0.25
HGT_DIM = 3601
HGT_BYTES = 2 * HGT_DIM * HGT_DIM
NO_DATA = -32768
ZOOM = 12
MARGIN = 0.01
MAX_LAT = 85.0511287798066
EARTH_RADIUS = 6378137.0
EXTENSIONS = {"raw": "", "gzip": ".gz", "lz4": ".lz4"}
INDEX_FILE = "index.bin"
INDEX_BIN_FORMAT = "<QLL"
PROGRESS_FILE = ".mapterhorn-to-valhalla.progress"
TEMPORARY_PREFIX = ".mapterhorn-"
HGT_NAME = re.compile(r"^([NS])([0-9]{2})([WE])([0-9]{3})\.hgt(\.(gz|lz4))?$")
CACHE_MB = 256
WARP_MB = 64
STOPPING = threading.Event()
PROCESSES = set()
MEMORY = []

def get_tile_path(cell):
  """Return the path of a cell's .hgt file relative to the elevation directory, as Valhalla names it."""
  hemisphere = "S" if cell.lat < 0 else "N"
  dir_name = "%s%02d" % (hemisphere, abs(cell.lat))
  tile_name = "%s%02d%s%03d.hgt" % (hemisphere, abs(cell.lat), "W" if cell.lon < 0 else "E", abs(cell.lon))
  return Path(dir_name, tile_name)

def grid_from_bounds(bounds):
  """Yield the 1x1 degree grid rectangles covering the given bounds."""
  min_x = floor(bounds[0])
  min_y = floor(bounds[1])
  max_x = ceil(bounds[-2])
  max_y = ceil(bounds[-1])
  for x in range(min_x, max_x):
    for y in range(min_y, max_y):
      yield [x, y, x + 1, y + 1]

def get_cells_with_geojson(input_dir):
  """Return the cells intersecting the polygons of the .geojson files in a directory."""
  geometry = ensure_package("shapely.geometry", "shapely")
  if not input_dir.is_dir() or not len(list(input_dir.glob("*.geojson"))) > 0:
    LOGGER.critical(f"Geojson directory does not exist or contains no GeoJSON files: {input_dir.resolve()}")
    sys.exit(1)

  def get_outer_rings(input_dir):
    """Yield the outer ring of every polygon in the .geojson files of a directory."""
    for file in input_dir.glob("*.geojson"):
      with open(file) as f:
        geojson = json.load(f)
      for feature in geojson["features"]:
        if feature["geometry"]["type"] == "Polygon":
          yield geometry.Polygon(feature["geometry"]["coordinates"][0])
        if feature["geometry"]["type"] == "MultiPolygon":
          for single_polygon in feature["geometry"]["coordinates"]:
            yield geometry.Polygon(single_polygon[0])
  cells = set()
  for poly in get_outer_rings(input_dir):
    for rect in grid_from_bounds(poly.bounds):
      if poly.intersects(geometry.box(*rect)):
        cells.add(Cell(rect[0], rect[1]))
  return cells

def get_cells_with_bbox(bbox_str):
  """Return the cells intersecting a minX,minY,maxX,maxY bounding box."""
  try:
    bbox = [float(x) for x in bbox_str.split(",")]
  except ValueError:
    LOGGER.critical(f"BBOX {bbox_str} is not a comma-separated string of coordinates.")
    sys.exit(1)
  if len(bbox) != 4 or bbox[0] > bbox[2] or bbox[0] < -180 or bbox[2] > 180 or bbox[1] > bbox[3] or bbox[1] < -90 or bbox[3] > 90:
    LOGGER.critical(f"Bbox invalid: {bbox}")
    sys.exit(1)
  return {Cell(rect[0], rect[1]) for rect in grid_from_bounds(bbox)}

def get_cells_with_graph(graph_dir):
  """Return the cells covered by the level-2 tiles of a Valhalla graph directory."""
  if not graph_dir.is_dir():
    LOGGER.critical(f"Graph directory {graph_dir.resolve()} does not exist.")
    sys.exit(1)
  cells = set()
  local_dir = graph_dir.joinpath("2")
  tile_width = int(360 / LOCAL_SIZE)
  for tile_fp in local_dir.rglob("*.gph"):
    tile_id = int(str(tile_fp.parent.relative_to(local_dir).joinpath(tile_fp.stem)).replace(os.sep, ""))
    tile_x = floor(int(tile_id % tile_width) * LOCAL_SIZE - 180)
    tile_y = floor(int(tile_id / tile_width) * LOCAL_SIZE - 90)
    cells.add(Cell(tile_x, tile_y))
  return cells

def get_cells_with_extract(extract_fp):
  """Return the cells covered by the level-2 tiles listed in the index.bin of a Valhalla tile extract."""
  with tarfile.open(extract_fp) as tar:
    member = tar.next()
    if member is not None and member.name == INDEX_FILE:
      graph_ids = [entry[1] for entry in struct.iter_unpack(INDEX_BIN_FORMAT, tar.extractfile(member).read())]
    else:
      LOGGER.info(f"No {INDEX_FILE} in {extract_fp}, reading its tile names.")
      names = [m.name for m in tar if m.name.startswith("2/") and m.name.endswith(".gph")]
      graph_ids = [2 | (int(name[2:-4].replace("/", "")) << 3) for name in names]
  cells = set()
  tile_width = int(360 / LOCAL_SIZE)
  for graph_id in graph_ids:
    if graph_id & 0x7 != 2:
      continue
    tile_id = (graph_id & 0x1fffff8) >> 3
    tile_x = floor(int(tile_id % tile_width) * LOCAL_SIZE - 180)
    tile_y = floor(int(tile_id / tile_width) * LOCAL_SIZE - 90)
    cells.add(Cell(tile_x, tile_y))
  return cells

def get_window(cell):
  """Return the cell's bounds with a margin, limited to the Web Mercator extent, or None outside it."""
  min_lat = max(cell.lat - MARGIN, -MAX_LAT)
  max_lat = min(cell.lat + 1 + MARGIN, MAX_LAT)
  if min_lat >= max_lat:
    return None
  return [max(cell.lon - MARGIN, -180.0), min_lat, min(cell.lon + 1 + MARGIN, 180.0), max_lat]

def mercator_x(lon):
  """Return the Web Mercator x coordinate of a longitude."""
  return EARTH_RADIUS * radians(lon)

def mercator_y(lat):
  """Return the Web Mercator y coordinate of a latitude."""
  return EARTH_RADIUS * log(tan(pi / 4 + radians(lat) / 2))

def wms_xml(url):
  """Return a GDAL WMS description of a z/x/y Terrarium tile service at the given URL template."""
  extent = mercator_x(180.0)
  return (
    "<GDAL_WMS><Service name=\"TMS\"><ServerUrl>" + url + "</ServerUrl></Service>"
    "<DataWindow><UpperLeftX>" + repr(-extent) + "</UpperLeftX><UpperLeftY>" + repr(extent) + "</UpperLeftY>"
    "<LowerRightX>" + repr(extent) + "</LowerRightX><LowerRightY>" + repr(-extent) + "</LowerRightY>"
    "<TileLevel>" + str(ZOOM) + "</TileLevel><TileCountX>1</TileCountX><TileCountY>1</TileCountY><YOrigin>top</YOrigin></DataWindow>"
    "<Projection>EPSG:3857</Projection><BlockSizeX>512</BlockSizeX><BlockSizeY>512</BlockSizeY><BandsCount>3</BandsCount>"
    "<ZeroBlockHttpCodes>204,404</ZeroBlockHttpCodes></GDAL_WMS>"
  )

def vrt_xml(url, window):
  """Return a GDAL VRT that decodes the Terrarium tiles of a window at the given URL template into elevations, with black pixels as no data."""
  wms = wms_xml(url)
  source = gdal.Open(wms)
  origin_x, size_x, _, origin_y, _, size_y = source.GetGeoTransform()
  x_off = floor((mercator_x(window[0]) - origin_x) / size_x)
  y_off = floor((mercator_y(window[3]) - origin_y) / size_y)
  x_size = ceil((mercator_x(window[2]) - origin_x) / size_x) - x_off
  y_size = ceil((mercator_y(window[1]) - origin_y) / size_y) - y_off
  geotransform = ", ".join(repr(value) for value in (origin_x + x_off * size_x, size_x, 0.0, origin_y + y_off * size_y, 0.0, size_y))
  escaped = wms.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
  rects = f"<SrcRect xOff=\"{x_off}\" yOff=\"{y_off}\" xSize=\"{x_size}\" ySize=\"{y_size}\"/><DstRect xOff=\"0\" yOff=\"0\" xSize=\"{x_size}\" ySize=\"{y_size}\"/>"
  sources = "".join(f"<SimpleSource><SourceFilename relativeToVRT=\"0\">{escaped}</SourceFilename><SourceBand>{band}</SourceBand>{rects}</SimpleSource>" for band in (1, 2, 3))
  expression = "(B1 == 0 &amp;&amp; B2 == 0 &amp;&amp; B3 == 0) ? %d : B1 * 256 + B2 + B3 / 256 - 32768" % NO_DATA
  return (
    f"<VRTDataset rasterXSize=\"{x_size}\" rasterYSize=\"{y_size}\"><SRS>EPSG:3857</SRS><GeoTransform>{geotransform}</GeoTransform>"
    f"<VRTRasterBand dataType=\"Float32\" band=\"1\" subClass=\"VRTDerivedRasterBand\"><NoDataValue>{NO_DATA}</NoDataValue>"
    f"<PixelFunctionType>expression</PixelFunctionType><PixelFunctionArguments expression=\"{expression}\" dialect=\"muparser\"/>"
    f"<SourceTransferType>Float64</SourceTransferType>{sources}</VRTRasterBand></VRTDataset>"
  )

def write(path, data, compression):
  """Write a cell's elevation file atomically with the requested compression."""
  if compression == "gzip":
    data = gzip.compress(data)
  elif compression == "lz4":
    lz4 = ensure_package("lz4.frame", "lz4")
    with lz4.LZ4FrameCompressor(block_size=lz4.BLOCKSIZE_MAX4MB, compression_level=6) as compressor:
      data = compressor.begin(HGT_BYTES) + compressor.compress(data) + compressor.flush()
  path.parent.mkdir(parents=True, exist_ok=True)
  temporary = path.with_name("." + path.name + ".tmp")
  temporary.write_bytes(data)
  os.replace(temporary, path)
  remove_cell_files(path.parent.joinpath(path.name.split(".")[0] + ".hgt"), keep=path)

def remove_cell_files(path, keep=None):
  """Remove the cell's .hgt files in every format, except the one to keep."""
  for extension in EXTENSIONS.values():
    other = path.with_name(path.name.split(".")[0] + ".hgt" + extension)
    if other != keep:
      other.unlink(missing_ok=True)

def peak_memory_mb():
  """Return the peak resident memory of this process in MB."""
  fields = dict(line.split(":", 1) for line in Path("/proc/self/status").read_text().splitlines())
  return int(fields["VmHWM"].split()[0]) // 1024

def convert(archive_name, cell, port, path, compression, measure):
  """Convert the z12 tiles of a served archive into a cell's elevation file, returning whether one was written and, when measuring, its peak memory in MB."""
  if measure:
    Path("/proc/self/clear_refs").write_text("5")
  gdal.UseExceptions()
  gdal.SetConfigOption("GDAL_NUM_THREADS", "1")
  gdal.SetCacheMax(CACHE_MB * 1024 * 1024)
  decoded = gdal.Open(vrt_xml("http://127.0.0.1:%d/%s/${z}/${x}/${y}.webp" % (port, archive_name), get_window(cell)))
  half = 0.5 / (HGT_DIM - 1)
  hgt = gdal.Warp("", decoded, format="MEM", dstSRS="EPSG:4326", outputBounds=[cell.lon - half, cell.lat - half, cell.lon + 1 + half, cell.lat + 1 + half], width=HGT_DIM, height=HGT_DIM, resampleAlg="bilinear", srcNodata=NO_DATA, dstNodata=NO_DATA, outputType=gdal.GDT_Int16, warpMemoryLimit=WARP_MB)
  heights = hgt.ReadAsArray()
  if (heights == NO_DATA).all():
    remove_cell_files(path)
    return False, peak_memory_mb() if measure else None
  write(path, heights.astype(">i2").tobytes(), compression)
  return True, peak_memory_mb() if measure else None

def extract(source, archive, window):
  """Extract the z12 tiles of a window from the Mapterhorn archive, retrying like valhalla_build_elevation."""
  command = ["pmtiles", "extract", source, str(archive), "--bbox=%.6f,%.6f,%.6f,%.6f" % tuple(window), "--minzoom=%d" % ZOOM, "--maxzoom=%d" % ZOOM]
  for i in range(5):
    if STOPPING.wait((i**2) / 2 * 30):
      return False
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
    PROCESSES.add(process)
    output = process.communicate()[0]
    PROCESSES.discard(process)
    if process.returncode == 0:
      if i:
        LOGGER.info(f"Extracting {archive.stem} succeeded.")
      return True
    reason = (re.findall(r"\d{4}/\d\d/\d\d \d\d:\d\d:\d\d \S+: ([^\r\n]*)", output) or [f"exit code {process.returncode}"])[-1]
    LOGGER.error(f"Extracting {archive.stem} failed: {reason}." + (" Trying again..." if i < 4 else ""))
  return False

def is_done(cell, outdir, done, migrate):
  """Return whether a cell is listed as processed or, without migrating, already has a file in any format."""
  path = outdir.joinpath(get_tile_path(cell))
  if path.stem in done:
    return True
  return not migrate and any(path.with_name(path.stem + ".hgt" + extension).is_file() for extension in EXTENSIONS.values())

def process_cell(cell, settings, converters):
  """Extract, convert and write one cell, returning its outcome."""
  path = settings["outdir"].joinpath(get_tile_path(cell)).with_suffix(".hgt" + EXTENSIONS[settings["compression"]])
  name = path.name.split(".")[0]
  if is_done(cell, settings["outdir"], settings["done"], settings["migrate"]):
    return "skipped"
  if STOPPING.is_set():
    return "stopped"
  window = get_window(cell)
  archive = settings["tmpdir"].joinpath(name + ".pmtiles")
  try:
    if window is None:
      remove_cell_files(path)
      written = False
    elif not extract(settings["source"], archive, window):
      if STOPPING.is_set():
        return "stopped"
      LOGGER.error(f"Tile {path.name} couldn't be extracted...")
      return "failed"
    elif STOPPING.is_set():
      return "stopped"
    else:
      with settings["slots"]:
        if STOPPING.is_set():
          return "stopped"
        written, peak = converters.submit(convert, archive.stem, cell, settings["port"], path, settings["compression"], LOGGER.isEnabledFor(logging.INFO)).result()
      if peak is not None:
        MEMORY.append(peak)
  except Exception as e:
    LOGGER.error(f"Tile {path.name} failed: {e}")
    return "failed"
  finally:
    archive.unlink(missing_ok=True)
  with settings["lock"]:
    settings["progress"].write(name + "\n")
    settings["progress"].flush()
    count = next(settings["count"])
    latest = f"{'Wrote' if written else 'No Mapterhorn data for'} {path.relative_to(settings['outdir'])}"
    if settings["bar"].disable:
      LOGGER.info(f"{latest} ({count}/{settings['remaining']})")
    else:
      settings["status"].set_description_str(latest)
      settings["bar"].update()
  return "written" if written else "no data"

def remove_leftovers(outdir):
  """Remove the temporary directories and files of an interrupted run."""
  for leftover in outdir.glob(TEMPORARY_PREFIX + "*"):
    if leftover.is_dir():
      shutil.rmtree(leftover, ignore_errors=True)
  for leftover in outdir.glob("*/.*.hgt*.tmp"):
    leftover.unlink(missing_ok=True)

def remove_unselected(outdir, cells, done):
  """Remove the files of cells outside the selection, and drop them from the processed cells."""
  names = {get_tile_path(cell).stem for cell in cells}
  for path in outdir.glob("*/*.hgt*"):
    if HGT_NAME.match(path.name) and path.name.split(".")[0] not in names:
      LOGGER.info(f"Removing {path.relative_to(outdir)}")
      path.unlink()
  return done & names

def init_converter():
  """Leave stop signals to the main process."""
  signal.signal(signal.SIGINT, signal.SIG_IGN)
  signal.signal(signal.SIGTERM, signal.SIG_IGN)

def tick(bar, finished):
  """Refresh the progress bar every second until finished, so its times advance between cells."""
  while not finished.wait(1):
    bar.refresh()

def log_memory():
  """Log the mean and max peak memory of the conversions so far."""
  if MEMORY:
    LOGGER.info(f"Memory per conversion: mean {sum(MEMORY) // len(MEMORY)} MB, max {max(MEMORY)} MB, of {len(MEMORY)} conversions.")

def stop(signum, frame):
  """Finish the cells in progress and start no new ones; on a second signal, kill the children and exit at once."""
  if STOPPING.is_set():
    LOGGER.critical("Stopping now.")
    log_memory()
    for child in multiprocessing.active_children():
      child.kill()
    for process in list(PROCESSES):
      process.kill()
    os._exit(1)
  LOGGER.critical("Stopping after the cells in progress. Repeat to stop now.")
  STOPPING.set()

def free_port():
  """Return a free local TCP port."""
  with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    return s.getsockname()[1]

def serve(directory, port):
  """Start pmtiles serve on a local port for the archives in a directory, returning the process once it accepts connections."""
  process = subprocess.Popen(["pmtiles", "serve", str(directory), "--interface=127.0.0.1", "--port=%d" % port], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
  PROCESSES.add(process)
  for i in range(100):
    try:
      socket.create_connection(("127.0.0.1", port), timeout=1).close()
      return process
    except OSError:
      time.sleep(0.1)
  process.terminate()
  LOGGER.critical("pmtiles serve did not start.")
  sys.exit(1)

def main():
  """Parse the command line, select the cells and write their elevation files."""
  args = docopt(__doc__)
  handler = logging.StreamHandler()
  handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)5s: %(message)s"))
  LOGGER.addHandler(handler)
  LOGGER.setLevel([logging.CRITICAL, logging.INFO][min(args["--verbosity"], 1)])
  config = dict()
  if args["--config"]:
    with open(args["--config"]) as f:
      config = json.load(f)
  config.update(**json.loads(args["--inline-config"]))
  if args["--outdir"]:
    outdir = Path(args["--outdir"])
  elif config:
    outdir = Path(config["additional_data"]["elevation"] or "elevation")
  else:
    LOGGER.critical("Either config or outdir is required.")
    sys.exit(1)
  from_tiles = not (args["--from-geojson"] or args["--from-bbox"])
  if args["--from-geojson"]:
    cells = get_cells_with_geojson(Path(args["--from-geojson"]))
  elif args["--from-bbox"]:
    cells = get_cells_with_bbox(args["--from-bbox"])
  else:
    if not config:
      LOGGER.critical("--from-tiles requires a config to be specified.")
      sys.exit(1)
    tile_dir = config["mjolnir"].get("tile_dir")
    tile_extract = config["mjolnir"].get("tile_extract")
    if tile_extract and not (tile_dir and Path(tile_dir, "2").is_dir()) and Path(tile_extract).is_file():
      cells = get_cells_with_extract(Path(tile_extract))
    else:
      cells = get_cells_with_graph(Path(tile_dir or "valhalla_tiles"))
  if not cells:
    LOGGER.critical("No cells selected.")
    sys.exit(1)
  compression = "raw" if args["--decompress"] else "lz4" if args["--lz4"] else "gzip"
  parallelism = int(args["--parallelism"]) if args["--parallelism"] else len(os.sched_getaffinity(0))
  os.environ["no_proxy"] = ",".join(filter(None, [os.environ.get("no_proxy"), "127.0.0.1"]))
  outdir.mkdir(parents=True, exist_ok=True)
  remove_leftovers(outdir)
  progress_fp = outdir.joinpath(PROGRESS_FILE)
  done = set(progress_fp.read_text().split()) if progress_fp.is_file() else set()
  if args["--migrate"] and from_tiles:
    done = remove_unselected(outdir, cells, done)
  progress_fp.write_text("".join(name + "\n" for name in sorted(done)))
  remaining = sum(1 for cell in cells if not is_done(cell, outdir, done, args["--migrate"]))
  if args["--migrate"]:
    LOGGER.info(f"Migrating, {len(cells) - remaining} cells already processed, {remaining} remaining." if len(cells) > remaining else f"Migrating every cell, {remaining} remaining.")
  signal.signal(signal.SIGINT, stop)
  signal.signal(signal.SIGTERM, stop)
  with tempfile.TemporaryDirectory(prefix=TEMPORARY_PREFIX, dir=outdir) as tmpdir, open(progress_fp, "a") as progress:
    port = free_port()
    server = serve(tmpdir, port)
    settings = {"outdir": outdir, "tmpdir": Path(tmpdir), "source": args["--source"], "port": port, "compression": compression, "migrate": args["--migrate"], "done": done, "progress": progress, "lock": threading.Lock(), "slots": threading.Semaphore(parallelism), "count": itertools.count(1), "remaining": remaining}
    settings["bar"] = tqdm(total=remaining, unit="cell", ncols=70, smoothing=0, disable=not (sys.stderr.isatty() and LOGGER.isEnabledFor(logging.INFO)))
    settings["status"] = tqdm(total=0, position=1, bar_format="{desc}", leave=False, disable=settings["bar"].disable)
    finished = threading.Event()
    threading.Thread(target=tick, args=(settings["bar"], finished), daemon=True).start()
    try:
      with logging_redirect_tqdm(loggers=[LOGGER]), ProcessPoolExecutor(parallelism, initializer=init_converter) as converters, ThreadPoolExecutor(2 * parallelism) as workers:
        outcomes = list(workers.map(partial(process_cell, settings=settings, converters=converters), sorted(cells)))
    finally:
      finished.set()
      settings["status"].close()
      settings["bar"].close()
      server.terminate()
      server.wait()
  counts = {outcome: outcomes.count(outcome) for outcome in ("written", "skipped", "no data", "failed", "stopped")}
  log_memory()
  LOGGER.info(f"Cells: {len(outcomes)}, " + ", ".join(f"{key}: {value}" for key, value in counts.items()) + ". Exiting.")
  if counts["failed"] or counts["stopped"]:
    sys.exit(1)

if __name__ == "__main__":
  main()
